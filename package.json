{
  "name": "lumalens",
  "version": "1.0.0",
  "description": "Cinematic screen translation for Windows",
  "main": "desktop/main.cjs",
  "author": "xelaods",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": { "tesseract.js": "7.0.0" },
  "devDependencies": { "electron": "45.1.0", "electron-builder": "26.18.0" },
  "build": {
    "appId": "io.github.xelaods.lumalens",
    "productName": "LumaLens",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "lib/**/*", "ui/**/*", "assets/**/*", "tests/desktop-smoke.cjs", "package.json"],
    "asarUnpack": ["node_modules/tesseract.js/**", "node_modules/tesseract.js-core/**"],
    "win": { "target": ["nsis", "portable"], "signExecutable": false, "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "LumaLens-${version}-${arch}-Setup.${ext}" },
    "portable": { "artifactName": "LumaLens-${version}-${arch}-Portable.${ext}", "useZip": true }
  }
}
